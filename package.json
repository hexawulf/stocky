{
  "name": "stocky",
  "version": "1.2.0",
  "private": true,
  "description": "Self-hosted homelab hardware inventory: what is in your machines, and what is in stock.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hexawulf/stocky.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write --experimental-cli src/",
    "test": "vitest run",
    "test:api": "scripts/test-api.sh",
    "test:e2e": "scripts/test-e2e.sh",
    "test:e2e:live": "STOCKY_BASE_URL=${STOCKY_LIVE_URL:-http://127.0.0.1:5030} npx playwright test"
  },
  "dependencies": {
    "pocketbase": "^0.28.1",
    "vue": "^3.6.0-rc.0",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "prettier": "3.10.1",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "overrides": {
    "vue": "^3.6.0-rc.0",
    "@vue/compiler-core": "^3.6.0-rc.0",
    "@vue/compiler-dom": "^3.6.0-rc.0",
    "@vue/compiler-sfc": "^3.6.0-rc.0",
    "@vue/compiler-ssr": "^3.6.0-rc.0",
    "@vue/compiler-vapor": "^3.6.0-rc.0",
    "@vue/reactivity": "^3.6.0-rc.0",
    "@vue/runtime-core": "^3.6.0-rc.0",
    "@vue/runtime-dom": "^3.6.0-rc.0",
    "@vue/runtime-vapor": "^3.6.0-rc.0",
    "@vue/server-renderer": "^3.6.0-rc.0",
    "@vue/shared": "^3.6.0-rc.0",
    "@vue/compat": "^3.6.0-rc.0",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9",
    "source-map-js": "^1.2.4"
  }
}
